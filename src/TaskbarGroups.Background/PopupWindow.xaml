<Window x:Class="TaskbarGroups.Background.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A thin bar for a panel taller than the screen, which only a folder with a
             lot in it gets: the stock one is a wide grey channel that belongs to no
             panel of Windows'. Dragged or wheeled; the channel itself is not clickable. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="{DynamicResource FlyoutLineBrush}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FlyoutHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FlyoutPressBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The mark on a folder that opens beside the panel, as a submenu's arrow. -->
        <Style x:Key="Chevron" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE76C;" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Foreground" Value="{DynamicResource FlyoutTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="{Binding HasChildren, Converter={StaticResource Visible}}" />
        </Style>

        <!-- The icon with its name underneath: the look every group had before the
             layouts existed, and still the default. -->
        <DataTemplate x:Key="TileWithLabel">
            <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                    Click="Item_Click" ToolTip="{Binding DisplayName}"
                    Width="80" Height="88" Margin="2">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="44" Height="44"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource FlyoutTextBrush}"
                                   FontSize="11" TextAlignment="Center" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="68" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Chevron}" HorizontalAlignment="Right"
                               VerticalAlignment="Top" Margin="0,-2,-2,0" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- The icon alone, compact like the taskbar itself. The name is still
             there as a tooltip. -->
        <DataTemplate x:Key="TileIconOnly">
            <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                    Click="Item_Click" ToolTip="{Binding DisplayName}"
                    Width="52" Height="52" Margin="2">
                <Grid>
                    <Image Source="{Binding Icon}" Width="32" Height="32"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Style="{StaticResource Chevron}" HorizontalAlignment="Right"
                               VerticalAlignment="Top" Margin="0,-4,-4,0" FontSize="8" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- The icon with its name beside it, for a column: reads like a menu. -->
        <DataTemplate x:Key="LineWithLabel">
            <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                    Click="Item_Click" HorizontalContentAlignment="Stretch"
                    MinWidth="190" Height="44" Margin="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{DynamicResource FlyoutTextBrush}"
                               FontSize="13" VerticalAlignment="Center" Margin="12,0,8,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="220" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Chevron}" Margin="0,0,4,0" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- The same, at a fixed width, so a list can wrap into even columns. -->
        <DataTemplate x:Key="ListCell">
            <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                    Click="Item_Click" HorizontalContentAlignment="Stretch"
                    Width="200" Height="44" Margin="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{DynamicResource FlyoutTextBrush}"
                               FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="140" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Chevron}" Margin="4,0,2,0" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- A line across the panel that splits the apps into sections, with its
             title in the middle when it has one. In a grid it is exactly as wide
             as a row of cells (SeparatorRowWidth, set with the layout), so the apps
             after it start on a row of their own. -->
        <DataTemplate x:Key="SeparatorAcross">
            <Grid Width="{DynamicResource SeparatorRowWidth}" Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="12" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Margin="8,0,0,0" VerticalAlignment="Center"
                           Fill="{DynamicResource FlyoutLineBrush}" />
                <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding DisplayName}" Margin="10,0"
                           Foreground="{DynamicResource FlyoutTextBrush}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                <Rectangle Grid.Column="2" Height="1" Margin="0,0,8,0" VerticalAlignment="Center"
                           Fill="{DynamicResource FlyoutLineBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DisplayName}" Value="">
                    <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The same line standing up, between two apps of a single row. -->
        <DataTemplate x:Key="SeparatorDown">
            <Rectangle Width="1" Margin="6,12" Fill="{DynamicResource FlyoutLineBrush}" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="GridPanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="RowPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ColumnPanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="8" Padding="10"
            Background="#F0202020" BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1">
        <!-- Named so a peeking panel can fade its apps in; the glass behind them cannot fade. -->
        <DockPanel x:Name="ContentHost">
            <!-- The group's name, with a pencil that opens its editor straight away. -->
            <Grid x:Name="HeaderBar" DockPanel.Dock="Top" Margin="8,0,0,4" Visibility="Collapsed">
                <TextBlock x:Name="HeaderText" Foreground="{DynamicResource FlyoutTextBrush}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="260" HorizontalAlignment="Left"
                           Margin="0,0,72,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenAllButton" Style="{StaticResource IconButton}"
                            Width="32" Height="32" Click="OpenAll_Click">
                        <TextBlock x:Name="OpenAllGlyph" Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{DynamicResource FlyoutTextBrush}" />
                    </Button>
                    <Button x:Name="EditButton" Style="{StaticResource IconButton}"
                            Width="32" Height="32" Click="Edit_Click">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{DynamicResource FlyoutTextBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
            <!-- What a folder group says when there is nothing to list. -->
            <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Visibility="Collapsed"
                       Foreground="{DynamicResource FlyoutTextBrush}" Opacity="0.75" FontSize="13"
                       Margin="12,10" MaxWidth="260" TextWrapping="Wrap" />
            <!-- Scrolls only when the panel would be taller than the screen. -->
            <ScrollViewer x:Name="ItemsScroll" Focusable="False"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ItemsHost" ItemTemplate="{StaticResource TileWithLabel}"
                              ItemsPanel="{StaticResource GridPanel}" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
