<Application x:Class="TaskbarGroups.Background.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskbarGroups.Background">
    <!-- No WPF-UI dictionaries here on purpose. The flyout is a plain Window that
         styles its own single button template and defines its own brushes, so it
         uses no WPF-UI control at all; the one thing it borrows from that library
         is WindowBackdrop, which is interop and needs no styles. Merging the full
         themes and controls dictionaries was pure startup cost on a window that
         has to appear the moment the cursor rests on an icon. -->
    <Application.Resources />
</Application>
