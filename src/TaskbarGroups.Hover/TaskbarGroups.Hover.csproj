<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TaskbarGroups.Core\TaskbarGroups.Core.csproj" />
    <ProjectReference Include="..\TaskbarGroups.Background\TaskbarGroups.Background.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Not for any window of our own: this pulls in UIAutomationClient, which is
         the only supported way to read the Windows 11 taskbar's XAML buttons. -->
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\assets\Icon.ico</ApplicationIcon>
    <AssemblyTitle>Taskbar Groups Hover Watcher</AssemblyTitle>
    <Product>Taskbar Groups Fluent</Product>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\Icon.ico" Link="Icon.ico" />
  </ItemGroup>

</Project>
