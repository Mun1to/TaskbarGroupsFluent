<ui:FluentWindow x:Class="TaskbarGroups.App.PinAllWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{DynamicResource Loc_PinAll_Window}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        Topmost="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="Manual">

    <!-- Stays on top, beside the File Explorer window it keeps pointing at the next
         shortcut to pin, so the list is in sight while the user right-clicks. -->
    <StackPanel>
        <ui:TitleBar Title="{DynamicResource Loc_PinAll_Window}" Padding="12,6"
                     ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Margin="20,4,20,16">
            <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="IntroText" Text="{DynamicResource Loc_PinAll_Intro}" FontSize="13" Margin="0,0,0,12"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- What to do with the shortcut File Explorer has selected now. -->
            <Border x:Name="NowCard" Padding="12,10" CornerRadius="8" Margin="0,0,0,12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="NowTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="NowSteps" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="StepsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                       FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="12" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="NoteText" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <Border Padding="20,12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <ui:Button x:Name="ReopenButton" Content="{DynamicResource Loc_PinAll_Reopen}"
                           Icon="{ui:SymbolIcon FolderOpen24}" HorizontalAlignment="Left" Click="Reopen_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="SkipButton" Content="{DynamicResource Loc_PinAll_Skip}" Margin="0,0,8,0"
                               Click="Skip_Click" />
                    <ui:Button x:Name="CloseButton" Content="{DynamicResource Loc_Common_Close}"
                               Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</ui:FluentWindow>
