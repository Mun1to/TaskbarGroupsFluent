<ui:FluentWindow x:Class="TaskbarGroups.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{DynamicResource Loc_Settings_Title}"
        Height="480" Width="560"
        MinHeight="400" MinWidth="480"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource Loc_Settings_Title}" Padding="12,6" />

        <StackPanel Grid.Row="1" Margin="24,4,24,12">
            <TextBlock Text="{DynamicResource Loc_Settings_Heading}"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
            <StackPanel>

                <ui:Card Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="Cursor24" FontSize="22"
                                       VerticalAlignment="Center" Margin="0,0,14,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Loc_Settings_HoverTitle}"
                                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Loc_Settings_HoverSubtitle}"
                                       FontSize="12" Margin="0,3,12,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Column="2" x:Name="HoverToggle"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="{DynamicResource Loc_Settings_HoverTitle}"
                                         Checked="HoverToggle_Changed"
                                         Unchecked="HoverToggle_Changed" />
                    </Grid>
                </ui:Card>

                <ui:Card x:Name="DelayCard" Padding="16" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="Timer24" FontSize="22"
                                       VerticalAlignment="Center" Margin="0,0,14,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Loc_Settings_DelayTitle}"
                                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Loc_Settings_DelaySubtitle}"
                                       FontSize="12" Margin="0,3,12,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Column="2" x:Name="DelayBox" MinWidth="140"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="{DynamicResource Loc_Settings_DelayTitle}"
                                  SelectionChanged="DelayBox_Changed" />
                    </Grid>
                </ui:Card>

                <ui:InfoBar x:Name="HoverNotice" Margin="0,10,0,0"
                            Severity="Informational" IsClosable="False"
                            IsOpen="False"
                            Message="{DynamicResource Loc_Settings_HoverRunning}" />

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="24,12" Margin="0,12,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,1,0,0">
            <ui:Button Content="{DynamicResource Loc_Common_Close}"
                       Appearance="Primary"
                       HorizontalAlignment="Right" Click="Close_Click" />
        </Border>
    </Grid>
</ui:FluentWindow>
