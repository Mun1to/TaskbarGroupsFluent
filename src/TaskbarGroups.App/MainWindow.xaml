<ui:FluentWindow x:Class="TaskbarGroups.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:TaskbarGroups.App"
        mc:Ignorable="d"
        Title="Taskbar Groups"
        Height="620" Width="940"
        MinHeight="480" MinWidth="680"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <!-- One option of a quick-bar choice (theme, language): a flat chip that is
             lit while chosen, like the segmented controls of winshotx. -->
        <Style x:Key="QuickSegment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="5" Padding="8,3" MinHeight="24"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickGroup" TargetType="Border">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Taskbar Groups" Padding="12,6">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" Width="18" Height="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="28,8,28,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_Main_Heading}"
                               FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Loc_Main_Subheading}"
                               FontSize="13" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Content="{DynamicResource Loc_Main_Import}"
                               Icon="{ui:SymbolIcon ArrowImport24}"
                               Margin="0,0,8,0"
                               Click="ImportButton_Click" />
                    <ui:Button Icon="{ui:SymbolIcon Settings24}"
                               ToolTip="{DynamicResource Loc_Settings_Title}"
                               AutomationProperties.Name="{DynamicResource Loc_Settings_Title}"
                               Margin="0,0,8,0"
                               Click="SettingsButton_Click" />
                    <ui:Button Content="{DynamicResource Loc_Main_SeparatorButton}"
                               Icon="{ui:SymbolIcon Add24}"
                               ToolTip="{DynamicResource Loc_Main_AddSeparator}"
                               AutomationProperties.Name="{DynamicResource Loc_Main_AddSeparator}"
                               Margin="0,0,8,0"
                               Click="AddSeparatorButton_Click" />
                    <ui:Button x:Name="AddGroupButton"
                               Content="{DynamicResource Loc_Main_AddGroup}"
                               Icon="{ui:SymbolIcon Add24}"
                               Appearance="Primary"
                               Click="AddGroupButton_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <Grid>
                    <ItemsControl x:Name="GroupsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,16,16" Width="248" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="11"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <Grid>
                                                    <ui:SymbolIcon Symbol="AppsList24" FontSize="26"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    <Image Source="{Binding Icon}" Width="40" Height="40"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding ShortcutCountText}" FontSize="12" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <!-- Duplicate, export: the occasional things, kept off the
                                                 everyday buttons below. -->
                                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon MoreHorizontal24}"
                                                       Appearance="Transparent" Padding="6" Margin="4,0,-6,0"
                                                       VerticalAlignment="Top"
                                                       ToolTip="{DynamicResource Loc_Group_More}"
                                                       AutomationProperties.Name="{DynamicResource Loc_Group_More}"
                                                       Tag="{Binding}" Click="MoreGroup_Click" />
                                        </Grid>

                                        <ui:Button Grid.Row="1" Content="{DynamicResource Loc_Main_Pin}"
                                                   Icon="{ui:SymbolIcon Pin24}"
                                                   Appearance="Primary" HorizontalAlignment="Stretch"
                                                   Tag="{Binding}" Click="PinToTaskbar_Click" />

                                        <Grid Grid.Row="2" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Content="{DynamicResource Loc_Common_Edit}" Icon="{ui:SymbolIcon Edit24}"
                                                       HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                                       Tag="{Binding}" Click="EditGroup_Click"
                                                       Visibility="{Binding IsSeparator, Converter={StaticResource NonSeparatorToVisibilityConverter}}" />
                                            <ui:Button Grid.Column="1" Content="{DynamicResource Loc_Common_Delete}" Icon="{ui:SymbolIcon Delete24}"
                                                       HorizontalAlignment="Stretch" Margin="4,0,0,0"
                                                       Tag="{Binding}" Click="DeleteGroup_Click" />
                                        </Grid>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0,60,0,0">
                        <ui:SymbolIcon Symbol="AppsAddIn24" FontSize="56"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Main_EmptyTitle}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Margin="0,16,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Main_EmptySubtitle}"
                                   FontSize="13" Margin="0,4,0,16" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:Button Content="{DynamicResource Loc_Main_CreateFirst}"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Appearance="Primary"
                                   HorizontalAlignment="Center"
                                   Click="AddGroupButton_Click" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- The quick bar: what gets changed often, at hand without opening the
             settings, and whether this is the latest version, which used to be
             invisible until an update popped up. The same settings keep their
             full rows in the settings window; this is the shortcut. -->
        <Border Grid.Row="2" MinHeight="44" Padding="16,6"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Left" Style="{StaticResource QuickGroup}"
                        ToolTip="{DynamicResource Loc_Quick_Theme}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource QuickSegment}"
                                     ToolTip="{DynamicResource Loc_Quick_ThemeSystem}"
                                     AutomationProperties.Name="{DynamicResource Loc_Quick_ThemeSystem}"
                                     Checked="Theme_Checked">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="14" />
                        </RadioButton>
                        <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource QuickSegment}"
                                     ToolTip="{DynamicResource Loc_Quick_ThemeLight}"
                                     AutomationProperties.Name="{DynamicResource Loc_Quick_ThemeLight}"
                                     Checked="Theme_Checked">
                            <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="14" />
                        </RadioButton>
                        <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource QuickSegment}"
                                     ToolTip="{DynamicResource Loc_Quick_ThemeDark}"
                                     AutomationProperties.Name="{DynamicResource Loc_Quick_ThemeDark}"
                                     Checked="Theme_Checked">
                            <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="14" />
                        </RadioButton>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Left" Style="{StaticResource QuickGroup}" Margin="10,0,0,0"
                        ToolTip="{DynamicResource Loc_Quick_Language}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangSystem" GroupName="Lang" Style="{StaticResource QuickSegment}"
                                     Content="Auto"
                                     ToolTip="{DynamicResource Loc_Quick_LangSystem}"
                                     AutomationProperties.Name="{DynamicResource Loc_Quick_LangSystem}"
                                     Checked="Lang_Checked" />
                        <RadioButton x:Name="LangEs" GroupName="Lang" Style="{StaticResource QuickSegment}"
                                     Content="ES" ToolTip="Español" AutomationProperties.Name="Español"
                                     Checked="Lang_Checked" />
                        <RadioButton x:Name="LangEn" GroupName="Lang" Style="{StaticResource QuickSegment}"
                                     Content="EN" ToolTip="English" AutomationProperties.Name="English"
                                     Checked="Lang_Checked" />
                    </StackPanel>
                </Border>

                <Rectangle DockPanel.Dock="Left" Width="1" Height="20" Margin="14,0"
                           Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="{DynamicResource Loc_Settings_HoverSubtitle}">
                    <ui:SymbolIcon Symbol="Cursor24" FontSize="14" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{DynamicResource Loc_Quick_Hover}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:ToggleSwitch x:Name="QuickHoverToggle" VerticalAlignment="Center"
                                     AutomationProperties.Name="{DynamicResource Loc_Quick_Hover}"
                                     Checked="QuickHover_Changed" Unchecked="QuickHover_Changed" />
                </StackPanel>

                <!-- Up to date, it is only the version and a green tick, which is
                     also the button to look again. When there is something to say
                     (a new version, a download, a failed check) the words and the
                     button come back, because that is what must not go unnoticed. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateText" FontSize="11.5" VerticalAlignment="Center"
                               Margin="0,0,8,0" Visibility="Collapsed"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:ProgressRing x:Name="UpdateRing" IsIndeterminate="True" Width="14" Height="14"
                                     Margin="0,0,8,0" Visibility="Collapsed" />
                    <ui:Button x:Name="UpdateNowButton" Content="{DynamicResource Loc_Update_Now}"
                               Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary"
                               FontSize="11" Padding="10,3" Margin="0,0,8,0" Visibility="Collapsed"
                               Click="UpdateNow_Click" />
                    <TextBlock x:Name="VersionText" FontSize="11" VerticalAlignment="Center"
                               Margin="0,0,2,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:Button x:Name="UpdateStatusButton" Appearance="Transparent" Padding="6"
                               BorderThickness="0" Background="Transparent"
                               Click="UpdateStatus_Click">
                        <Grid>
                            <ui:SymbolIcon x:Name="UpdateTick" Symbol="CheckmarkCircle24" FontSize="16"
                                           Foreground="#3FB950" Visibility="Collapsed" />
                            <ui:SymbolIcon x:Name="UpdateSync" Symbol="ArrowSync24" FontSize="15"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </ui:Button>
                </StackPanel>

                <!-- The coffee, the only way to support the app. Docked right after the
                     version, so it sits just left of it and never between two settings. -->
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" BorderThickness="0"
                           Background="Transparent" Padding="8,4" Margin="0,0,10,0"
                           VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Icon="{ui:SymbolIcon DrinkCoffee24}"
                           Content="{DynamicResource Loc_Quick_Support}"
                           ToolTip="{DynamicResource Loc_Quick_SupportTip}"
                           Click="Support_Click" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
