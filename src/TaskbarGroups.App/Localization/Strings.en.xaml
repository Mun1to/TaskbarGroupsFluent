    <s:String x:Key="Loc_Settings_DelayNormal">Normal</s:String>
    <s:String x:Key="Loc_Settings_DelayRelaxed">Relaxed</s:String>
    <s:String x:Key="Loc_Settings_AnimateTitle">Panel animation</s:String>
    <s:String x:Key="Loc_Settings_AnimateSubtitle">How a group comes and goes: rising a little while its apps fade in, or sliding out from behind the taskbar like the Start menu. With animation effects turned off in Windows, it doesn't move.</s:String>
    <s:String x:Key="Loc_Settings_AnimateNone">None</s:String>
