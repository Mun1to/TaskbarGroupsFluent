    <!-- Settings -->
    <s:String x:Key="Loc_Settings_Title">Settings</s:String>
    <s:String x:Key="Loc_Settings_Heading">Settings</s:String>
    <s:String x:Key="Loc_Settings_HoverTitle">Open on hover</s:String>
    <s:String x:Key="Loc_Settings_HoverSubtitle">Open a group by resting the cursor on its icon, no click needed. It needs a small program that sits in the notification area and starts with Windows.</s:String>
    <s:String x:Key="Loc_Settings_HoverRunning">It is running now. Its icon sits by the clock, possibly tucked behind the arrow; you can switch it off from there any time.</s:String>
    <s:String x:Key="Loc_Settings_HoverMissing">The program that watches the cursor was not found. Reinstall the app to restore it.</s:String>
    <s:String x:Key="Loc_Settings_InstantTitle">Open groups instantly</s:String>
    <s:String x:Key="Loc_Settings_InstantSubtitle">Keeps one panel loaded in the background, so even the first click after starting Windows opens at once. It needs the small program that sits by the clock and starts with Windows.</s:String>
    <s:String x:Key="Loc_Settings_TrayIconTitle">Show the icon by the clock</s:String>
    <s:String x:Key="Loc_Settings_TrayIconSubtitle">The small program by the clock keeps working without it. Turn this back on here to see its icon and its menu again.</s:String>
    <s:String x:Key="Loc_Settings_DelayTitle">How long to wait</s:String>
    <s:String x:Key="Loc_Settings_DelaySubtitle">How long the cursor has to rest on the icon before the group opens.</s:String>
