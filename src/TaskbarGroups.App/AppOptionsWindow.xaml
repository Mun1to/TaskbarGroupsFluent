<ui:FluentWindow x:Class="TaskbarGroups.App.AppOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{DynamicResource Loc_AppOpt_Title}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">

    <StackPanel>
        <ui:TitleBar Title="{DynamicResource Loc_AppOpt_Title}" Padding="12,6"
                     ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Margin="20,4,20,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Image x:Name="AppIcon" Width="32" Height="32" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="AppTitle" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <TextBlock Text="{DynamicResource Loc_AppOpt_Name}" FontSize="13" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:TextBox x:Name="NameBox" Margin="0,0,0,4" />
            <TextBlock Text="{DynamicResource Loc_AppOpt_NameHint}" FontSize="12" Margin="0,0,0,14"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <StackPanel x:Name="ProgramOnly">
                <TextBlock Text="{DynamicResource Loc_AppOpt_Args}" FontSize="13" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox x:Name="ArgsBox" Margin="0,0,0,4" />
                <TextBlock Text="{DynamicResource Loc_AppOpt_ArgsHint}" FontSize="12" Margin="0,0,0,14"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <ui:ToggleSwitch x:Name="AdminToggle" Content="{DynamicResource Loc_AppOpt_Admin}" />
                <TextBlock Text="{DynamicResource Loc_AppOpt_AdminHint}" FontSize="12" Margin="0,4,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <TextBlock x:Name="NotForThisKind" Text="{DynamicResource Loc_AppOpt_NotForStore}" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <Border Padding="20,12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{DynamicResource Loc_Common_Cancel}" Margin="0,0,8,0" Click="Cancel_Click" />
                <ui:Button Content="{DynamicResource Loc_AppOpt_Save}" Appearance="Primary" Click="Save_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</ui:FluentWindow>
