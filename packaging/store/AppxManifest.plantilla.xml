<?xml version="1.0" encoding="utf-8"?>
<!--
  El manifiesto del paquete de la Microsoft Store. No se edita a mano: lo rellena
  `packaging/store/msix.ps1` con la version del proyecto y con los datos de identidad de
  `packaging/store/identidad.json`, que son los que asigna Partner Center.

  Lo que no se ve a simple vista:

  - Hay DOS aplicaciones en el paquete. "App" es la ventana de los grupos, la que sale en
    el menu Inicio. "Panel" es el desplegable que abre cada grupo anclado; no sale en Inicio
    (AppListEntry="none") y existe para tener su propio alias de ejecucion.
  - Los alias (`TaskbarGroupsFluent.exe` y `TaskbarGroupsFluentPanel.exe`) aparecen en
    %LOCALAPPDATA%\Microsoft\WindowsApps y son la unica ruta estable hacia los ejecutables:
    la carpeta real dentro de WindowsApps cambia con cada actualizacion. Los accesos directos
    de los grupos y su menu del clic derecho apuntan a esos alias, nunca a la carpeta real.
  - Los tres programas van en la misma carpeta, sin la subcarpeta Background del
    instalador: cada uno lleva .NET dentro y juntos lo comparten en vez de duplicarlo.
  - El vigilante de "abrir al pasar el cursor" arranca con Windows por `StartupTask`, no por
    la entrada Run, que dentro de un paquete se escribe sin error y Windows no lee nunca.
    Va con Enabled="false": se enciende desde los ajustes, como siempre.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Taskbar Groups Fluent</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es-es" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="TaskbarGroups.App.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Taskbar Groups Fluent"
        Description="Group your apps into a single taskbar icon."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="TaskbarGroups.App.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="TaskbarGroupsFluent.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <desktop:Extension Category="windows.startupTask" Executable="TaskbarGroups.Hover.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="TaskbarGroupsFluentHover" Enabled="false" DisplayName="Taskbar Groups Fluent" />
        </desktop:Extension>
      </Extensions>
    </Application>

    <Application Id="Panel" Executable="TaskbarGroups.Background.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Taskbar Groups Fluent"
        Description="The flyout a pinned group opens."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="TaskbarGroups.Background.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="TaskbarGroupsFluentPanel.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
