<?xml version="1.0" encoding="utf-8"?>
<!--
  El manifiesto del paquete de la Microsoft Store. No se edita a mano: lo rellena
  `packaging/store/msix.ps1` con la version del proyecto y con los datos de identidad de
  `packaging/store/identidad.json`, que son los que asigna Partner Center.

  Lo que no se ve a simple vista:

  - Hay UNA sola aplicacion y UN solo alias, `TaskbarGroupsFluentPanel.exe`, que apunta al
    panel y no al ejecutable de la aplicacion. Las dos cosas las impone la Store: una segunda
    aplicacion oculta de Inicio (AppListEntry="none") la rechaza al subirla, por «aplicacion
    desatendida» que pide una exencion (HeadlessAppBypass), y un segundo alias en la misma
    aplicacion no pasa la validacion del manifiesto («windows.appExecutionAlias solo se debe
    declarar una vez»).
  - El alias aparece en %LOCALAPPDATA%\Microsoft\WindowsApps y es la unica ruta estable: la
    carpeta real dentro de WindowsApps cambia con cada actualizacion. Los accesos directos de
    los grupos apuntan a el, y tambien «Editar grupo» del clic derecho, con la opcion edit: el
    panel se la pasa a la aplicacion y se cierra. (Ojo: en un comentario XML no puede haber
    dos guiones seguidos, y el manifiesto deja de ser valido.)
  - Los tres programas van en la misma carpeta, sin la subcarpeta Background del
    instalador: cada uno lleva .NET dentro y juntos lo comparten en vez de duplicarlo.
  - El vigilante de "abrir al pasar el cursor" arranca con Windows por `StartupTask`, no por
    la entrada Run, que dentro de un paquete se escribe sin error y Windows no lee nunca.
    Va con Enabled="false": se enciende desde los ajustes, como siempre.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Taskbar Groups Fluent</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es-es" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="TaskbarGroups.App.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Taskbar Groups Fluent"
        Description="Group your apps into a single taskbar icon."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="TaskbarGroups.Background.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="TaskbarGroupsFluentPanel.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <desktop:Extension Category="windows.startupTask" Executable="TaskbarGroups.Hover.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="TaskbarGroupsFluentHover" Enabled="false" DisplayName="Taskbar Groups Fluent" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
